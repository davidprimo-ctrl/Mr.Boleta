PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# Base de datos (Neon)
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require

# Auth0
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.mrboleta.com

# Pagos: "mock" (simulada) o "mercadopago" (Checkout Pro)
PAYMENT_PROVIDER=mock

# Mercado Pago (solo si PAYMENT_PROVIDER=mercadopago)
# Access token de la pestaña "Prueba" o "Producción". Ambos pueden empezar por APP_USR-.
MP_ACCESS_TOKEN=
# Opcional: secreto del webhook (Panel de Mercado Pago → Webhooks)
MP_WEBHOOK_SECRET=

# Correo (opcional). Sin SMTP_HOST se usa Ethereal (modo de prueba)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=Mr.Boleta <no-responder@mrboleta.com>