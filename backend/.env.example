PORT=3000
FRONTEND_URL=http://localhost:5173

# Base de datos (Neon)
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require

# Auth0
AUTH0_DOMAIN=tu-tenant.us.auth0.com
